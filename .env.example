# Copy this file to ".env" and fill in your own values. Never upload ".env" to GitHub.

# PostgreSQL connection string (local example, or the one from Neon / Supabase)
DATABASE_URL=postgresql://stock:stockpass@localhost:5432/stockpilot

# A long random text used to sign login tokens. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text

PORT=3000
